# systemd service configuration file for WeeWX

[Unit]
Description=WeeWX weather system
Documentation=https://weewx.com/docs
Requires=time-sync.target
After=time-sync.target
Wants=network-online.target
After=network-online.target

# If you are using MySQL uncomment the following lines:
# After=mysqld.service
# Wants=mysqld.service

# If you are using MariaDB uncomment the following lines:
# After=mariadb.service
# Wants=mariadb.service

[Service]
ExecStart=/opt/weewx-venv/bin/python3 /opt/weewx-venv/lib/python3.11/site-packages/weewxd.py /app/config/weewx.conf
StandardOutput=null
StandardError=journal+console
User=root
Group=root

[Install]
WantedBy=multi-user.target
